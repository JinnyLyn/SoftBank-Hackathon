# 운영자/worker AWS account and region for the CloudFormation connection link.
PLATFORM_AWS_ACCOUNT_ID=
AWS_REGION=sa-east-1
AWS_CONNECTION_TEMPLATE_URL=
# Optional private artifact bucket for server deployments. Leave blank for local development.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_PREFIX=paved-clouds
ARTIFACT_S3_SSE=AES256
ARTIFACT_S3_KMS_KEY_ID=
# Enable only after infra/worker downloads source and plan via the authenticated API.
WORKER_ARTIFACT_DOWNLOADS_ENABLED=false
# Public HTTPS base URL of this backend, used by the CloudFormation role callback.
PUBLIC_API_BASE_URL=
