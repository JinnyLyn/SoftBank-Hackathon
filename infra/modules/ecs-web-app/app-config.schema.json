{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paved-clouds/ecs-web-app/app-config",
  "title": "ecs-web-app LLM 입력",
  "description": "LLM이 3·5단계에서 내는 구성값. variables.tf의 LLM 입력 변수와 같은 규칙이다. 한쪽을 바꾸면 다른 쪽도 같이 바꾼다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["container_port", "health_check_path", "task_size", "min_tasks", "max_tasks", "use_database", "environment"],
  "properties": {
    "container_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "health_check_path": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._~/-]*$",
      "maxLength": 128
    },
    "task_size": {
      "type": "string",
      "enum": ["xsmall", "small", "medium"]
    },
    "min_tasks": {
      "type": "integer",
      "enum": [1, 2]
    },
    "max_tasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "use_database": {
      "type": "boolean"
    },
    "environment": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]{0,63}$",
        "not": {
          "anyOf": [
            { "const": "DATABASE_URL" },
            { "pattern": "(SECRET|PASSWORD|PASSWD|TOKEN|PRIVATE|CREDENTIAL|API_?KEY|ACCESS_?KEY)" }
          ]
        }
      },
      "additionalProperties": { "type": "string" }
    },
    "init_command": {
      "description": "앱 이미지로 apply 뒤에 1회 실행할 초기화 명령(예: [\"python\", \"-m\", \"backend.app.initialize_database\"]). 여러 번 실행돼도 안전해야 한다(CREATE TABLE IF NOT EXISTS). Terraform 변수가 아니라 deploy.sh가 쓴다. 생략할 수 있다",
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  }
}
