# ai/.env 로 복사해서 값을 채운다. ai/.env 는 커밋되지 않는다 (루트 .gitignore)
# 값은 문서·로그·채팅에 남기지 않는다
# 기본: Ollama 클라우드 (glm-5.3)
OLLAMA_API_KEY=
# 대안: Anthropic. Ollama 키가 없거나 PAVED_AI_PROVIDER=anthropic 일 때
ANTHROPIC_API_KEY=
# 키가 워크스페이스에 묶여 있지 않으면 필요 (Console → Workspaces 의 ID). 워크스페이스 키를 쓰면 비워 둠
# ANTHROPIC_WORKSPACE_ID=
# 선택: ollama / anthropic (비우면 있는 키로 고름, Ollama 먼저)
# PAVED_AI_PROVIDER=
# 선택: 기본 Ollama glm-5.3, Anthropic claude-opus-5-5
# PAVED_AI_MODEL=glm-5.3
